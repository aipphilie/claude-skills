{
  "extraKnownMarketplaces": {
    "remotion": {
      "source": {
        "source": "github",
        "repo": "remotion-dev/claude-code-plugin"
      }
    }
  },
  "enabledPlugins": {
    "remotion@remotion": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v higgsfield >/dev/null 2>&1 || npm i -g @higgsfield/cli >/dev/null 2>&1 || true",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
