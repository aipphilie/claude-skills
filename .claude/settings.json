{
  "extraKnownMarketplaces": {
    "remotion": {
      "source": {
        "source": "github",
        "repo": "remotion-dev/claude-code-plugin"
      }
    }
  },
  "enabledPlugins": {
    "remotion@remotion": true
  },
  "enabledMcpjsonServers": ["codebase-memory-mcp"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v higgsfield >/dev/null 2>&1 || npm i -g @higgsfield/cli >/dev/null 2>&1 || true",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "(npx -y codebase-memory-mcp@0.12.1 cli --quiet index_repository --repo-path \"$CLAUDE_PROJECT_DIR\" >/dev/null 2>&1 &) ; true",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'codebase-memory-mcp подключён: для вопросов по коду и структуре репо сначала используй его инструменты (search_graph, get_architecture, trace_path, search_code), а потом уже Grep/Read.'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
