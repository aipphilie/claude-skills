   [.9,(g,t)=>{bgFill(g,P.terraL);girl(g,420,560,.6,t);at(g,420,130,pop(t,.05),()=>plaque(g,'БЫВШАЯ',P.cream,64))},{zoom:1.3,shake:2}],
