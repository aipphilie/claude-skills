   [1.4,(g,t)=>{bgFill(g,P.terraL);friend(g,250,560,.6,'angry',t);friend(g,590,560,.6,'norm',t);at(g,250,170,pop(t,.1),()=>qmark(g,P.choc,110));at(g,590,170,pop(t,.3),()=>qmark(g,P.choc,110));at(g,420,880,pop(t,.2),()=>plaque(g,'ОБИДЕЛСЯ?',P.cream,60))},{zoom:1.3}],
