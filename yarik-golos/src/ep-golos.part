   [1.8,(g,t)=>{bgFill(g,P.sage);rays(g,420,495,'rgba(246,238,221,.3)',t);at(g,420,450,2.4,()=>{brain(g,'#E7B3A0');brainEyes(g,t,0)});at(g,660,240,pop(t,.4),()=>check(g));at(g,420,880,pop(t,.2),()=>plaque(g,'ПРИВЫКАЕТ',P.cream,60))},{zoom:1.25,push:.05}]])}},
