 // 8 — лайфхак
 {txt:'[softly] Как привыкнуть: послушай себя на записи несколько раз подряд. Мозг бесится от непривычки и со временем перестаёт.',bg:P.sage,lux:2,cw:['Как','послушай','несколько','Мозг','и'],draw(g,t,d){shots(g,t,d,[
