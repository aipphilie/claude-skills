   [2.4,(g,t)=>{bgFill(g,P.beige);yk(g,420,690,.75,'laugh',t);at(g,420,160,pop(t,.05),()=>plaque(g,'ПИШИ В КОММЕНТЫ',P.mustard,56));at(g,190,420,pop(t,.4)*.8,()=>chat(g,'выношу'));at(g,640,470,pop(t,.7)*.8,()=>chat(g,'ненавижу 😩'));at(g,420,900,pop(t,1.2),()=>tag(g,'Подробнее в Telegram',P.cream,30))},{zoom:1.3}]])}},
];
// cues по словам (cw): номер слова, с которого начинается кадр
{const cl=s=>s.replace(/\[[a-z -]+\]\s*/g,'').replace(/́/g,'').trim();for(const s of SC){if(!s.cw)continue;const ws=cl(s.txt).split(/\s+/);let k=0;s.cues=s.cw.map((w,j)=>{if(j===0){k=0;return 0}const i=ws.indexOf(w,k+1);k=i<0?k:i;return k})}}
